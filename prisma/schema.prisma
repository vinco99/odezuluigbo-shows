generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(cuid())
  name                  String
  email                 String                @unique
  password              String?
  role                  Role                  @default(USER)
  creditBalance         Int                   @default(0)
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  image                 String?
  imagePublicId         String?
  phone                 String?               @unique
  emailVerified         DateTime?
  bio                   String?
  country               String?
  coverImage            String?
  username              String?               @unique

  accounts              Account[]
  blogs                 Blog[]
  comments              Comment[]
  contestants           Contestant[]
  events                Event[]

  notifications         Notification[]
  organizerApplications OrganizerApplication?
  pendingApplication    PendingApplication[]
  sessions              Session[]

  payments              Payment[]
  tickets               Ticket[]
  voter                 Vote[]
  creditTransactions    CreditTransaction[]
  tasksCreated          Task[]                @relation("TasksCreated")
  tasksReviewed         UserTaskCompletion[]  @relation("TasksReviewed")
  taskCompletions       UserTaskCompletion[]
  otps                  Otp[]
  resetTokens           ResetToken[]

  suspended             Boolean   @default(false)   
  suspendedAt           DateTime?

  @@index([suspended])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String?
  expires_at        Int?
  id_token          String?
  refresh_token     String?
  scope             String?
  session_state     String?
  token_type        String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id                      String               @id @default(cuid())
  title                   String
  description             String

  logo                    String?
  logoPublicId            String?
  banner                  String?
  bannerPublicId          String?

  registrationFee         Float                @default(0)
  votingFee               Float                @default(0)
  status                  EventStatus          @default(PENDING)
  organizerId             String

  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  
  eventDate               DateTime?
  isVotingOpen            Boolean              @default(false)
  maxContestants          Int?
  registrationEnd         DateTime?
  registrationStart       DateTime?

  slug                    String               @unique
  state                   String?
  country                 String?
  type                    EventType
  venue                   String?

  prize1st                Float?   
  prize2nd                Float?   
  prize3rd                Float?   

  videos                  EventVideo[]

  contestants             Contestant[]
  organizer               User                 @relation(fields: [organizerId], references: [id])
  galleries               Gallery[]
  judges                  Judge[]
  pendingApplication      PendingApplication[]
  sponsors                Sponsor[]

  payments                Payment[]
  ticketPackages          TicketPackage[]
  tickets                 Ticket[]
  tasks                   Task[]
  creditLimitPerSession   Int?      
  voteSessions            VoteSession[]
  votes                   Vote[]
  faq                     EventFaq[]
}

model Contestant {
  id                String            @id @default(cuid())
  name              String

  portrait          String?
  portraitPublicId  String?

  fullPhoto         String?
  fullPhotoPublicId String?

  bio               String?
  age               Int?
  birthday          DateTime?
  height            Int?             
  phone             String?
  email             String?
  state             String?
  city              String?

  institution       String?
  course            String?
  occupation        String?
  talent            String?

  userId            String
  facebook          String?
  instagram         String?
  tiktok            String?

  guardianName      String?
  guardianRelation  String?
  guardianPhone     String?

  eventId           String
  createdAt         DateTime          @default(now())
  applicationStatus ApplicationStatus @default(PENDING)

  paymentId         String            @unique

  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payment           Payment           @relation(fields: [paymentId], references: [id])
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes             Vote[]

  @@index([eventId, applicationStatus])
  @@index([userId, eventId])
}

model Gallery {
  id             String   @id @default(cuid())
  eventId        String
  image          String
  imagePublicId  String?                 
  caption        String?                  
  sortOrder      Int      @default(0)     
  active         Boolean  @default(true)  
  createdAt      DateTime @default(now()) 

  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, active, sortOrder])
}

model PendingApplication {
  id                  String   @id @default(cuid())
  userId              String
  eventId             String

  name                String
  phone               String
  state               String
  portrait            String
  portraitPublicId    String
  fullPhoto           String
  fullPhotoPublicId   String
  email               String
  city                String
  age                 Int
  institution         String?
  course              String?
  occupation          String?

  instagram           String?
  facebook            String?
  tiktok              String?
  talent              String?
  bio                 String
  
  guardianName        String?
  guardianRelation    String?
  guardianPhone       String?

  createdAt           DateTime @default(now())
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model OrganizerApplication {
  id           String            @id @default(cuid())
  userId       String            @unique
  businessName String
  photo        String?
  photoId      String?
  phone        String
  email        String
  experience   String?
  proposal     String
  status       ApplicationStatus @default(PENDING)
  reviewNote   String?
  createdAt    DateTime          @default(now())
  reviewedAt   DateTime?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model Payment {
  id         String        @id @default(cuid())
  reference  String        @unique
  amount     Decimal       @db.Decimal(10, 2)
  type       PaymentType
  status     PaymentStatus
  userId     String?                                  
  eventId    String?
  createdAt  DateTime      @default(now())

  user       User?         @relation(fields: [userId], references: [id])
  event      Event?         @relation(fields: [eventId], references: [id])
  ticket     Ticket?
  contestant Contestant? 

  @@index([eventId, status])
  @@index([userId])
}

model Judge {
  id            String   @id @default(cuid())
  name          String
  image         String?
  imagePublicId String?
  title         String?              
  bio           String?              
  eventId       String
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, active, sortOrder])
}

model Sponsor {
  id            String      @id @default(cuid())
  name          String
  logo          String?
  logoPublicId  String?
  website       String?
  tier          SponsorTier @default(PARTNER)
  eventId       String
  sortOrder     Int         @default(0)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  ads           Ad[]

  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, active, sortOrder])
}

enum SponsorTier {
  PLATINUM
  GOLD
  SILVER
  BRONZE
  PARTNER
}

model CreditPackage {
  id         String   @id @default(cuid())
  name       String                        
  credits    Int                            
  amount     Float                           
  active     Boolean  @default(true)
  featured   Boolean  @default(false)        
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([active, sortOrder])
}

model VoteSession {
  id                 String   @id @default(cuid())
  eventId            String
  name               String                       
  startsAt           DateTime
  endsAt             DateTime
  creditLimitPerUser Int?                         
  createdAt          DateTime @default(now())

  event              Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  votes              Vote[]

  @@index([eventId, startsAt])
}

model Vote {
  id           String        @id @default(cuid())
  voterId      String
  eventId      String
  contestantId String
  quantity     Int
  amount       Float
  creditsUsed  Int           @default(0)
  reference    String        @unique
  status       PaymentStatus
  createdAt    DateTime      @default(now())

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  contestant   Contestant    @relation(fields: [contestantId], references: [id])
  voter        User          @relation(fields: [voterId], references: [id])

  sessionId    String?                            
  session      VoteSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([voterId, sessionId])
}

model CreditTransaction {
  id                String   @id @default(cuid())
  userId            String
  amount            Int                        
  type              CreditTxType                
  title             String
  detail            String?
  reference         String?                  
  status            CreditTxStatus            
  taskCompletion    UserTaskCompletion?
  createdAt         DateTime @default(now())

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum CreditTxType {
  PURCHASE
  SPEND_VOTE
  REFUND
  BONUS
  ADJUSTMENT
}

enum CreditTxStatus {
  COMPLETED
  PENDING
  FAILED
}

model Blog {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  content       String
  coverImage    String?
  coverImageId  String?
  authorId      String
  createdAt     DateTime     @default(now())
  authorName    String
  category      BlogCategory
  author        User         @relation(fields: [authorId], references: [id])
  comments      Comment[]

  @@index([category])
  @@index([createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  blogId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TicketPackage {
  id          String   @id @default(cuid())
  eventId     String
  name        String              
  description String?
  price       Float
  perks       String[]            
  maxQuantity Int?                
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@index([eventId, active])
}

model Ticket {
  id           String        @id @default(cuid())
  code         String        @unique          
  holderName   String
  holderEmail  String
  holderPhone  String

  packageId    String
  eventId      String
  paymentId    String        @unique
  buyerId      String?

  status       TicketStatus  @default(PENDING)
  emailSentAt  DateTime?
  checkedInAt  DateTime?
  createdAt    DateTime      @default(now())

  package      TicketPackage @relation(fields: [packageId], references: [id])
  event        Event         @relation(fields: [eventId], references: [id])
  payment      Payment       @relation(fields: [paymentId], references: [id])
  buyer        User?         @relation(fields: [buyerId], references: [id])

  @@index([eventId, status])
  @@index([holderEmail])
}

enum TicketStatus {
  PENDING      
  VALID        
  CHECKED_IN   
  CANCELLED
  REFUNDED
}

model Notification {
  id     String  @id @default(cuid())
  userId String
  title  String
  body   String
  read   Boolean @default(false)
  user   User    @relation(fields: [userId], references: [id])
}

enum BlogCategory {
  CULTURE
  ENTERTAINMENT
  DIASPORA
  HERITAGE
  LIFESTYLE
  SUCCESS
  EVENTS
}

enum Role {
  USER
  CONTESTANT
  ORGANIZER
  JUDGE
  ADMIN
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  LIVE
  SUSPENDED
}

enum EventType {
  PAGEANT
  REALITY_SHOW
  TALENT_SHOW
  CULTURAL_FESTIVAL
  MUSIC
  COMEDY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentType {
  CONTESTANT_REGISTRATION
  VOTE
  SPONSORSHIP
  EVENT_REGISTRATION
  EVENT_TICKET
  CREDIT_PURCHASE
}

enum TaskKind {
  VIDEO       
  SOCIAL      
  SURVEY   
  CUSTOM
}

enum TaskVerification {
  AUTO        
  TIMED       
  MANUAL      
}

enum TaskCompletionStatus {
  PENDING
  APPROVED
  REJECTED
}


model Task {
  id             String            @id @default(cuid())
  title          String
  description    String?
  reward         Int                              
  kind           TaskKind          @default(CUSTOM)
  verification   TaskVerification  @default(AUTO)
  actionUrl      String?                           
  minSeconds     Int?                              
  cooldownHours  Int?                              
  maxCompletions Int?                              
  eventId        String?                           
  active         Boolean           @default(true)
  createdById    String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  event          Event?                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy      User                  @relation("TasksCreated", fields: [createdById], references: [id])
  completions    UserTaskCompletion[]

  @@index([active, eventId])
}

model UserTaskCompletion {
  id           String                @id @default(cuid())
  userId       String
  taskId       String
  status       TaskCompletionStatus  @default(PENDING)
  rewardAmount Int                  
  proof        String?               
  creditTxId   String?               @unique
  startedAt    DateTime?
  completedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?
  createdAt    DateTime              @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  task         Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  creditTx     CreditTransaction?  @relation(fields: [creditTxId], references: [id])
  reviewedBy   User?               @relation("TasksReviewed", fields: [reviewedById], references: [id])

  @@index([userId, taskId])
  @@index([status])
}

model Song {
  id             String   @id @default(cuid())
  title          String
  artist         String
  streamingUrl   String
  platform       String   @default("youtube-music")
  coverImage     String?                              
  coverPublicId  String?                              
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)                 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, createdAt])
}

model SiteStat {
  id        String   @id @default(cuid())
  key       String   @unique   
  label     String            
  value     String             
  suffix    String?             
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

enum AdType {
  IMAGE    
  HTML    
  ADSENSE   
}

model Ad {
  id              String    @id @default(cuid())
  placementKey    String                                // matches AD_PLACEMENTS[].key
  title           String                                // "March Dangote Promo"
  type            AdType    @default(IMAGE)

  // IMAGE ads
  imageUrl        String?
  imagePublicId   String?
  linkUrl         String?

  // HTML / ADSENSE ads
  htmlCode        String?   @db.Text

  // Optional link to a Sponsor entity so finance can tie ads to deals
  sponsorId       String?
  sponsor         Sponsor?  @relation(fields: [sponsorId], references: [id], onDelete: SetNull)

  // Scheduling
  startAt         DateTime?
  endAt           DateTime?

  // Control
  active          Boolean   @default(true)
  sortOrder       Int       @default(0)                 

  // Analytics
  impressions     Int       @default(0)
  clicks          Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([placementKey, active, sortOrder])
  @@index([placementKey, startAt, endAt])
}

enum EventVideoKind {
  LIVE     
  UPCOMING  
  REPLAY     
  HIGHLIGHT  
  OTHER
}

model EventVideo {
  id          String         @id @default(cuid())
  eventId     String
  youtubeId   String                              
  title       String
  description String?
  kind        EventVideoKind @default(OTHER)
  isPrimary   Boolean        @default(true)     
  active      Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, active, sortOrder])
  @@index([eventId, isPrimary])
}

model EventFaq {
  id        String   @id @default(cuid())
  eventId   String
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, active, sortOrder])
}

model Otp {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  method    String
  contact   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}